{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "lock": { "frozen": true },
  "imports": {
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.3.16",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "check": "deno check backend/ scripts/",
    "test": "deno test --allow-read backend/",
    "test:unit": "deno test backend/supabase/functions/",
    "test:db": "deno test --allow-read backend/supabase/tests/",
    "build:web": "deno run --allow-read --allow-write=web/js --allow-run scripts/build_web_engine.ts",
    "verify": "deno fmt --check && deno lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "proseWrap": "preserve",
    "include": [
      "backend/",
      "scripts/",
      "web/js/",
      "web/config.example.js",
      "e2e/",
      "docs/",
      "README.md",
      ".github/"
    ],
    "exclude": ["web/js/engine.js", "e2e/package-lock.json"]
  },
  "lint": {
    "include": ["backend/", "scripts/", "web/js/", "web/config.example.js", "e2e/"],
    "exclude": ["web/js/engine.js"],
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-window"]
    }
  },
  "exclude": [
    ".cache/",
    "node_modules/",
    "ios/",
    "e2e/node_modules/",
    "e2e/test-results/",
    "e2e/playwright-report/"
  ]
}
