// Copy to Secrets.xcconfig (gitignored) and fill in your Supabase project
// (Supabase dashboard > Project Settings > API).
//
// "//" starts a comment in .xcconfig files, so keep the $() between the
// slashes of the URL.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-key
