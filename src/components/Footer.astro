---
import LogoMark from './LogoMark.astro';

interface Props {
  home?: boolean;
}

const { home = true } = Astro.props;
---

<footer>
  <div class="wrap">
    <LogoMark href={home ? '#top' : '/'} label="FutureClarity Technologies" />
    <span>Custom dashboards, workflows, websites &amp; app cleanup</span>
  </div>
</footer>
