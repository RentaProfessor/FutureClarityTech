---
import LogoMark from './LogoMark.astro';

interface Props {
  home?: boolean;
}

const { home = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="wrap">
    <LogoMark href={home ? '#top' : '/'} />
    <span>Websites, apps, SEO, hosting &amp; automations</span>
  </div>
  <!-- The privacy link has to stand out from the text around it (California's CalOPPA). -->
  <div class="wrap legal">
    <span>© {year} FutureClarity Technologies · San Fernando Valley, California</span>
    <span class="links"
      ><a href="/privacy/">Privacy Policy</a><a href="/terms/">Terms</a><a href="/accessibility/">Accessibility</a><button
        type="button"
        class="linkish"
        data-cookie-settings>Cookie settings</button
      ></span
    >
  </div>
</footer>
