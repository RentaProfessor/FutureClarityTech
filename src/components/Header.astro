---
import LogoMark from './LogoMark.astro';

interface Props {
  // On the homepage the nav scrolls to in-page sections. Anywhere else (the
  // 404 page) the same links have to navigate home first, so they are
  // prefixed with "/" and the browser handles the jump natively.
  home?: boolean;
}

const { home = true } = Astro.props;
const base = home ? '' : '/';

const links = [
  { href: `${base}#services`, label: 'Services' },
  { href: `${base}#how`, label: 'How it works' },
  { href: `${base}#why`, label: 'Why us' },
  { href: `${base}#faq`, label: 'FAQ' },
];
---

<!-- Three parts: the logo at the left edge, the sections centered on the page, and the
     button with the phone number after it at the right edge. -->
<header>
  <div class="wrap">
    <LogoMark href={home ? '#top' : '/'} />
    <nav aria-label="Sections">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="hright">
      <a class="hcall" href="tel:+18189397964" aria-label="Call (818) 939-7964">
        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#phoneIcon"></use></svg><span class="lbl">Call</span>
      </a>
      <a class="btn btn-primary" href={`${base}#contact`}>Get a free quote</a>
      <a class="hphone" href="tel:+18189397964" aria-label="Call or text (818) 939-7964"
        ><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#phoneIcon"></use></svg>(818) 939-7964</a
      >
    </div>
  </div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <path
        id="phoneIcon"
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"
      ></path>
    </defs>
  </svg>
</header>
