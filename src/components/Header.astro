---
import LogoMark from './LogoMark.astro';

interface Props {
  // On the homepage the nav scrolls to in-page sections. Anywhere else (the
  // 404 page) the same links have to navigate home first, so they are
  // prefixed with "/" and the browser handles the jump natively.
  home?: boolean;
}

const { home = true } = Astro.props;
const base = home ? '' : '/';

const links = [
  { href: `${base}#how`, label: 'How it works' },
  { href: `${base}#custom`, label: 'Custom' },
  { href: `${base}#web`, label: 'Websites & apps' },
  { href: `${base}#pricing`, label: 'Pricing' },
  { href: `${base}#process`, label: 'Process' },
];
---

<header>
  <div class="wrap">
    <LogoMark href={home ? '#top' : '/'} />
    <nav>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="btn btn-primary" href={`${base}#contact`}>Free audit</a>
  </div>
</header>
