---
// The free-quote form: one submit saves the request, then the form thanks the
// visitor in place. There is no step 2. Used in the hero (where ad clicks land)
// and again at the bottom of the page; the script in index.astro drives every
// form[data-lead], and a request sent from either one marks both as done.
import ContactVia from './ContactVia.astro';

const SITE = { email: 'beng@futureclaritytechnologies.com', phoneTel: '+18185850475', phoneDisplay: '(818) 585-0475' };

export interface Props {
  // prefix for this form's field ids, unique on the page
  id: string;
  // the hero form carries its own title; the contact section has one already
  title?: string;
}

const { id, title } = Astro.props;

// Optional quick picks, standing in for the old step 2. Every pick is written
// into "what they need" in plain words; an 'app…' pick also sets scope.app.
const picks = [
  ['website', 'A new website'],
  ['website-fix', 'Fix or update my site'],
  ['app', 'A new app'],
  ['app-fix', 'Fix my app'],
  ['seo', 'SEO'],
  ['hosting', 'Hosting or moving my site'],
  ['automation', 'Automations'],
];
---

<form class="lead glass" id={id} data-lead novalidate>
  <div class="lead-fields">
    {
      title && (
        <div class="lead-head">
          <h2>{title}</h2>
          <p>Free consultation. No obligation.</p>
        </div>
      )
    }
    <label class="fld"
      ><span>Your name</span><input id={`${id}-name`} type="text" name="name" autocomplete="name" required /></label
    >
    <label class="fld"
      ><span>Business name</span><input
        id={`${id}-business`}
        type="text"
        name="business"
        autocomplete="organization"
        required
      /></label
    >
    <ContactVia id={id} />
    <!-- Optional, and folded away: the first step is just the three fields and the button. -->
    <details class="more">
      <summary>What do you need? <i>optional</i></summary>
      <fieldset class="picks">
        <legend class="sr">What do you need</legend>
        <div class="chips">
          {picks.map(([value, label]) => <button type="button" data-pick={value} aria-pressed="false">{label}</button>)}
        </div>
      </fieldset>
      <textarea
        id={`${id}-msg`}
        name="msg"
        rows="3"
        aria-label="Add a note, optional"
        placeholder="Tell us about your project, or paste your current site's address"></textarea>
    </details>
    <!-- Bots fill every field; people never see this one. -->
    <label class="hp" aria-hidden="true">Leave this empty<input type="text" name="company_site" tabindex="-1" autocomplete="off" /></label>
    <button class="btn btn-primary" type="submit">Get my free quote</button>
    <!-- Consent sits right under the button it applies to (TCPA, carrier texting rules). -->
    <p class="consent">
      By sending this request, you agree FutureClarity Technologies may call, text or email you about it, including by
      automated means. Consent isn't required to buy anything. Msg frequency varies; msg &amp; data rates may apply.
      Reply STOP to opt out, HELP for help. <a href="/privacy/">Privacy Policy</a> · <a href="/terms/">Terms</a>
    </p>
    <p class="lead-trust">
      We reply within one business day · or call <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
    </p>
    <div class="formerr" role="alert" hidden>
      Add your name, business name and a phone number (with area code) or email so we can reach you.
    </div>
    <div class="sendfail" role="alert" hidden>
      <p>That didn't go through. Try again, or send it to us yourself:</p>
      <div class="row">
        <a class="btn" data-mail href={`mailto:${SITE.email}`}>Email it</a>
        <a class="btn" data-sms href={`sms:${SITE.phoneTel}`}>Text it</a>
      </div>
    </div>
  </div>
  <div class="lead-done" role="status" tabindex="-1" hidden>
    <div class="ok" aria-hidden="true">✓</div>
    <h3 data-done-title>Request sent. We've got it.</h3>
    <p>We'll call or text you within one business day to set up your free consultation. Nothing else to do.</p>
    <p class="lead-trust">Need us sooner? <a href={`tel:${SITE.phoneTel}`}>Call {SITE.phoneDisplay}</a></p>
  </div>
</form>
