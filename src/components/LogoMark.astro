---
interface Props {
  href?: string;
  label?: string;
}

const { href = '#top', label = 'FutureClarity Technologies, home' } = Astro.props;
---

<a href={href} class="logo" aria-label={label}>
  <svg viewBox="190 50 220 180" aria-hidden="true"><use href="#lensBeam" /></svg>
  <span class="wm">FUTURE <span>CLARITY</span></span>
</a>
