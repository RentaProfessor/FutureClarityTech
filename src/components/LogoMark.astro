---
interface Props {
  href?: string;
}

// The link's name is its visible text, "FUTURE CLARITY TECHNOLOGIES", so screen readers and
// voice control ("click Future Clarity") both find it (WCAG 2.5.3). The picture is decorative.
const { href = '#top' } = Astro.props;
---

<a href={href} class="logo">
  <img class="mark" src="/img/logo-mark.webp" alt="" width="174" height="128" />
  <span class="brand-name"><span>FUTURE <em>CLARITY</em></span> <small>TECHNOLOGIES</small></span>
</a>
