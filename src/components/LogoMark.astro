---
interface Props {
  href?: string;
  label?: string;
}

// The spoken name includes the visible words "Future Clarity" so voice control can find it (WCAG 2.5.3).
const { href = '#top', label = 'Future Clarity Technologies, home' } = Astro.props;
---

<a href={href} class="logo" aria-label={label}>
  <img class="mark" src="/img/logo-globe.webp" alt="" width="48" height="35" />
  <span class="wm"><b>Future Clarity</b><small>TECHNOLOGIES</small></span>
</a>
