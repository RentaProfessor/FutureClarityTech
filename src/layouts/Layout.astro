---
import '../styles/global.css';
import Consent from '../components/Consent.astro';

export interface Props {
  title: string;
  description?: string;
  // where "Skip to content" goes: the page's <main>
  main?: string;
  // the 404 page: keep it out of search results and give it no canonical URL
  noindex?: boolean;
}

const {
  title,
  // under ~155 characters, or Google cuts it off in results
  description = 'Websites and apps for San Fernando Valley businesses: new builds, fixes, SEO, hosting, site moves, edits and automations. Free consultation and free quote.',
  main = '#main',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data. Google had no machine-readable description of this company
// before; this is what feeds brand panels and AI summaries alongside the page
// copy. Deliberately an Organization rather than a LocalBusiness: a
// LocalBusiness without a real postal address or service area fails
// validation's recommended fields. Add the address here once it is settled,
// and keep the name, phone, email and service area matching the Google
// Business Profile listing (a service-area business covering Los Angeles).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: 'FutureClarity Technologies',
      // the spelling the page headline and logo use, so both names map to this company
      alternateName: 'Future Clarity Technologies',
      url: new URL('/', Astro.site).href,
      logo: new URL('/img/logo-mark.png', Astro.site).href,
      image: new URL('/og.png', Astro.site).href,
      description:
        'FutureClarity Technologies is a web and app development company in the San Fernando Valley, California. It builds and fixes websites and apps, and provides SEO, hosting, site migrations, edits and business automations.',
      email: 'beng@futureclaritytechnologies.com',
      telephone: '+1-818-585-0475',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+1-818-585-0475',
        email: 'beng@futureclaritytechnologies.com',
        contactType: 'sales',
        availableLanguage: 'English',
      },
      areaServed: [
        { '@type': 'Place', name: 'San Fernando Valley, CA' },
        { '@type': 'City', name: 'Los Angeles, CA' },
      ],
      knowsAbout: [
        'Website design and development',
        'Mobile app development',
        'Web app development',
        'Website and app repair',
        'Search engine optimization',
        'Website hosting',
        'Website migration',
        'Business automation',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      url: new URL('/', Astro.site).href,
      name: 'FutureClarity Technologies',
      description,
      publisher: { '@id': new URL('/#organization', Astro.site).href },
      inLanguage: 'en-US',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#f4fbf7" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico?v=5" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png?v=5" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=5" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=5" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FutureClarity Technologies" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FutureClarity Technologies: websites and apps, built right and kept running" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts are self-hosted (src/styles/global.css). The two every page shows first load early. -->
    <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  </head>
  <body>
    <a class="skip" href={main}>Skip to content</a>
    <slot />
    <Consent />
  </body>
</html>
