---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Astro emits this to dist/404.html. Cloudflare Pages serves it with a real
// HTTP 404 for any unmatched path. Without it, Pages falls back to index.html
// with HTTP 200 — a soft 404, which search engines index as a duplicate of
// the homepage.
---

<Layout
  title="Page not found | FutureClarity Technologies"
  description="That page doesn't exist. Head back to the homepage to see dashboards, automations, websites and app cleanup."
>
  <Header home={false} />

  <main id="main" tabindex="-1" class="wrap notfound">
    <div class="label">Error 404</div>

    <h1>That page doesn't exist.</h1>

    <p class="sub">
      The link may be out of date, or the address might have a typo in it. Nothing is broken on our
      end.
    </p>

    <div class="ctas">
      <a href="/" class="btn btn-primary">Back to homepage</a>
      <a href="/#contact" class="btn">Book a free audit</a>
    </div>
  </main>

  <Footer home={false} />
</Layout>
