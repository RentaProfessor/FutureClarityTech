---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';

// Booking a free audit lands on the team dashboard at /dashboard/ either way.
// Wider screens: the original form under #contact (step 1) hands off to
// /plan.html (step 2), which sends the request via public/fc-store.js.
// Phones: LeadForm sends it in one submit, in the hero (where ad clicks land)
// and again under #contact.
---

<Layout title="FutureClarity Technologies" main="#top">
  <Header />

  <main id="top" tabindex="-1">
    <!-- HERO. Wider screens: the centered pitch with the lens and two buttons.
         Phones: a short pitch, then the form (so an ad click lands on it), then the promises. -->
    <section class="hero">
      <div class="wrap">
        <svg class="mark" viewBox="150 30 300 220" aria-hidden="true">
          <path
            class="lens-anim"
            d="M300,58 Q352,140 300,222 Q248,140 300,58 Z"
            fill="url(#lensFill)"
            filter="url(#lensGlow)"></path>
          <line
            class="beam-anim"
            x1="150"
            y1="194"
            x2="450"
            y2="86"
            stroke="url(#beamFill)"
            stroke-width="2.5"
            filter="url(#lensGlow)"></line>
        </svg>
        <div class="label c">Dashboards &amp; automations for local businesses</div>
        <h1>Your business, <span class="grad">on one dashboard.</span></h1>
        <p class="sub">
          <span class="sub-wide"
            >We build you a custom dashboard and set up the automations behind it, around what your
            business needs. Bookings, reminders, reviews and follow-ups run on their own, and you see
            it all in one place.</span
          ><span class="sub-phone"
            >Missed calls get texted back, clients get reminders, reviews get asked for. Automatically,
            on one screen built for your business.</span
          >
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="#contact">Book a free audit</a>
          <a class="btn" href="#how">See how it works</a>
        </div>
        <div class="hero-form">
          <LeadForm id="hf" title="Book your free audit" />
        </div>
        <div class="who" aria-label="Who we work with">
          <span class="on">Barbershops &amp; salons</span><span>Auto repair &amp; detailing</span><span
          >Pet groomers</span><span>Tattoo studios</span><span>Fitness &amp; martial arts</span><span
          >Any appointment or walk-in business</span>
        </div>
        <div class="meta">
          <span>Free audit &amp; <b>fixed quote</b></span><span>Monthly care <b>optional</b></span><span
          >Demo <b>before you pay</b></span>
        </div>
        <!-- phones: what you can count on, and who it's for, under the form -->
        <div class="hero-notes">
          <ul class="promises">
            <li>Free audit at your business, then a fixed quote</li>
            <li>Try a working demo before you pay</li>
            <li>Monthly care is optional</li>
          </ul>
          <p class="for">
            Made for barbershops, salons, auto shops, pet groomers, tattoo studios, gyms and any
            appointment or walk-in business.
          </p>
        </div>
      </div>
    </section>

    <!-- 01 HOW IT WORKS -->
    <section id="how" style="padding-top:40px">
      <div class="wrap">
        <div class="head">
          <div class="label">01 · How it works</div>
          <h2>A dashboard up front. Automations behind it.</h2>
          <p class="sub">
            You get one screen built for your business. Behind it, we set up the workflows that do
            the repeat work for you, connected to the tools you already use.
          </p>
        </div>
        <div class="fb">
          <div class="dash glass" aria-label="Example dashboard for a barbershop">
            <div class="side-label">
              <span>Front end · your dashboard</span><em>Example: a barbershop</em>
            </div>
            <div class="title"><b>Today at the shop</b><span>Thu · 4 chairs</span></div>
            <div class="tiles">
              <div class="tile"><b>23</b><span>cuts today</span></div>
              <div class="tile g"><b>$640</b><span>taken today</span></div>
              <div class="tile w"><b>3</b><span>missed calls, texted back</span></div>
              <div class="tile"><b>+4</b><span>new reviews this week</span></div>
            </div>
            <div class="sched">
              <div><i>10:00</i><span>Marcos · fade</span><em class="ok">Confirmed</em></div>
              <div><i>10:30</i><span>Walk-in · beard trim</span><em>Walk-in</em></div>
              <div><i>11:00</i><span>Chris · kid's cut</span><em class="new">Booked online</em></div>
              <div><i>11:30</i><span>Open chair · Luis</span><em>Rebook list: 17</em></div>
            </div>
          </div>
          <div class="back glass" aria-label="Automations running behind the dashboard">
            <div class="side-label"><span>Back end · your workflows</span></div>
            <div class="auto">
              <i>01</i>
              <div>
                Online booking + reminders
                <small>Confirms each booking and texts a reminder the day before.</small>
              </div>
            </div>
            <div class="auto">
              <i>02</i>
              <div>
                Missed-call text-back
                <small>Every missed caller gets a booking link in seconds.</small>
              </div>
            </div>
            <div class="auto">
              <i>03</i>
              <div>
                Review requests
                <small>A thank-you text with your review link after each visit.</small>
              </div>
            </div>
            <div class="auto">
              <i>04</i>
              <div>
                Rebooking nudges
                <small>"Time for your next cut?" a few weeks after each visit.</small>
              </div>
            </div>
            <p class="note">
              Every business gets a different set. <b>An auto shop</b> might get "your car is ready"
              texts and estimate requests instead.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 CUSTOM -->
    <section id="custom" class="custom">
      <div class="wrap">
        <div class="band">
          <div class="band-copy">
            <div class="label">02 · Built around you</div>
            <h2>Tell us what you need. <span class="grad">We build the workflow.</span></h2>
            <p class="sub">
              You tell us what slows you down or what you wish you could see at a glance. Our
              developers build the automation behind it and put the results on your dashboard.
            </p>
            <div class="ctas-left">
              <a class="btn btn-primary" href="#contact">Tell us what you need</a>
            </div>
          </div>
          <div class="flow" aria-label="Example: from a request to a working workflow">
            <div class="bubble">
              <span class="whoby">What the owner asked for</span>
              "Text clients a reminder the day before, and show me each barber's total at the end of
              the day."
            </div>
            <div class="beam-line" aria-hidden="true"></div>
            <div class="stages">
              <span><i>01</i>Planned</span>
              <span><i>02</i>Built</span>
              <span><i>03</i>On your dashboard</span>
              <span class="on"><i>✓</i>Live</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 WEBSITES & APPS -->
    <section id="web">
      <div class="wrap">
        <div class="head">
          <div class="label">03 · Websites &amp; apps</div>
          <h2>The rest of how customers find you.</h2>
          <p class="sub">
            Your dashboard runs the business. Your website and app are what customers see first, so
            we fix those too.
          </p>
        </div>
        <div class="duo">
          <div class="card glass">
            <div class="tag">Websites</div>
            <h3>New site or a full revamp</h3>
            <p>A fast, phone-first site with your real hours, prices and a booking button that works.</p>
            <ul>
              <li>Built new, or rebuilt from the site you have now</li>
              <li>Same name, address, phone and hours as your Google, Apple Maps and Yelp listings</li>
              <li>Booking linked straight to your dashboard</li>
            </ul>
            <div class="prices">
              <div>
                <b>$300–$600</b><span>Landing page: one page with hours, prices, booking and map</span>
              </div>
              <div><b>$600–$1,200</b><span>Small website: up to 5 pages</span></div>
              <div>
                <b>$0 down</b><span
                >Around $59/mo with hosting and edits included, if you'd rather spread it out</span>
              </div>
            </div>
          </div>
          <div class="card glass">
            <div class="tag">Apps</div>
            <h3>App cleanup</h3>
            <p>
              Already have an app that's slow, buggy or out of date? We clean it up instead of
              starting over.
            </p>
            <ul>
              <li>Fix broken screens, sign-ins and checkout flows</li>
              <li>Speed it up and update the design</li>
              <li>Connect it to your dashboard and workflows</li>
            </ul>
            <div class="prices">
              <div>
                <b>$1,500–$4,000</b><span>Typical range. Fixed quote after a free review of your app</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 PRICING -->
    <section id="pricing" style="padding-top:20px">
      <div class="wrap">
        <div class="head">
          <div class="label">04 · Pricing</div>
          <h2>What it usually costs.</h2>
          <p class="sub">
            Every business needs something different, so these are typical ranges. Yours could come
            in lower or higher. After your free audit you get a fixed quote before any work starts.
          </p>
          <span class="pill">Founding clients · pricing toward the low end</span>
        </div>
        <div class="plans">
          <div class="plan glass">
            <div class="tag">Starter</div>
            <h3>Dashboard + 1 workflow</h3>
            <div class="price"><span class="typ">Typically</span>$400–$800</div>
            <div class="mo">Optional care: around $49/mo</div>
            <ul>
              <li>Your custom dashboard</li>
              <li>1 automation, such as booking + reminders</li>
              <li>Yours to keep, no monthly fee required</li>
            </ul>
            <a class="btn" href="#contact">Get a quote</a>
          </div>
          <div class="plan glass hot">
            <div class="tag">Most popular</div>
            <h3>Dashboard + 3 workflows</h3>
            <div class="price"><span class="typ">Typically</span>$1,000–$1,800</div>
            <div class="mo">Optional care: around $99/mo</div>
            <ul>
              <li>Your custom dashboard</li>
              <li>3 automations</li>
              <li>Weekly numbers email</li>
              <li>Yours to keep, no monthly fee required</li>
            </ul>
            <a class="btn btn-primary" href="#contact">Get a quote</a>
          </div>
          <div class="plan glass">
            <div class="tag">Growth</div>
            <h3>Dashboard + up to 5 workflows</h3>
            <div class="price"><span class="typ">Typically</span>$1,800–$3,000</div>
            <div class="mo">Optional care: around $179/mo</div>
            <ul>
              <li>Your custom dashboard</li>
              <li>Up to 5 automations</li>
              <li>With care: 1 new workflow each month</li>
            </ul>
            <a class="btn" href="#contact">Get a quote</a>
          </div>
        </div>
        <p class="swipe-hint">Swipe to compare plans</p>
        <p class="carenote">
          Care is optional. It covers the texts your workflows send, the software behind them,
          monitoring, fixes when a connected app changes, and small tweaks. Skip it and we set
          everything up on your own accounts, so you pay those small usage costs directly. Add or
          cancel care anytime.
        </p>
        <div class="fine">
          <span>
            <b>Websites</b> typically $300–$1,200, or $0 down around $59/mo · <b>App cleanup</b>
            typically $1,500–$4,000
          </span>
          <a href="#web">See websites &amp; apps →</a>
        </div>
      </div>
    </section>

    <!-- 05 PROCESS -->
    <section id="process">
      <div class="wrap">
        <div class="head">
          <div class="label">05 · Process</div>
          <h2>Three steps.</h2>
        </div>
        <div class="steps">
          <div class="step">
            <div class="dot">01</div>
            <h3>Free audit</h3>
            <p>We visit, see how your day runs, and find what to automate.</p>
          </div>
          <div class="step on">
            <div class="dot">02</div>
            <h3>Working demo</h3>
            <p>You try your dashboard and workflows before you pay.</p>
          </div>
          <div class="step">
            <div class="dot">03</div>
