---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';

// Booking a free audit is one step on every screen size: LeadForm sends the
// request straight to Supabase (public/fc-store.js). Phones get the form near
// the top as well, where ad clicks land.

// The industry photos are generated (Z-Image Turbo, Apache 2.0), not real
// shops or people. Swap in real client photos when you have them.
const niches = [
  { label: 'Barbershops & salons', img: '/img/niche-salon.jpg' },
  { label: 'Auto repair & detailing', img: '/img/niche-auto.jpg' },
  { label: 'Pet groomers', img: '/img/niche-groomer.jpg' },
  { label: 'Tattoo studios', img: '/img/niche-tattoo.jpg' },
  { label: 'Gyms & martial arts', img: '/img/niche-gym.jpg' },
];

const faqs = [
  {
    q: 'Do I have to switch from Square, Booksy or Vagaro?',
    a: "No. We build around the tools you already use, and if something can't connect we'll tell you at the audit, before you pay anything.",
  },
  {
    q: 'Is there a monthly fee?',
    a: "Not unless you want one. You pay once for the build and it's yours to keep. Monthly care is optional: it covers the texts your workflows send, the software behind them, monitoring, fixes and small tweaks. Skip it and we set everything up on your own accounts, so you pay those small usage costs directly.",
  },
  {
    q: 'What happens at the free audit?',
    a: "One of us comes to your business for about 30 minutes, sees how your day runs, and points out what's worth automating. Afterward you get a fixed quote. No obligation.",
  },
  {
    q: 'Do I pay before I see it working?',
    a: 'No. You try a working demo of your dashboard and texts first, then decide.',
  },
  {
    q: 'I just need a website. Do you do that?',
    a: "Yes. A one-page site with your hours, prices, booking and map is typically $300–$600. Up to 5 pages is $600–$1,200. Or $0 down at around $59/mo with hosting and edits included.",
  },
  {
    q: 'Where do you work?',
    a: "We're based in the San Fernando Valley and come to your business for the audit.",
  },
];
---

<Layout title="FutureClarity Technologies" main="#top">
  <!-- PREVIEW ONLY: ?bg=mist|stone|navy tries a background option. Remove once one is picked.
       It never runs on the live domain, only on localhost and Cloudflare preview links. -->
  <script is:inline>
    (() => {
      const preview = !/(^|\.)futureclaritytechnologies\.com$/.test(location.hostname);
      try { const b = new URLSearchParams(location.search).get('bg'); if (preview && b) document.documentElement.dataset.bg = b; } catch (e) {}
      // a switcher in the corner, so all three can be flipped through in one tab
      if (preview) addEventListener('DOMContentLoaded', () => {
        const bar = document.createElement('div');
        bar.setAttribute('aria-label', 'Preview background');
        bar.style.cssText = 'position:fixed;left:16px;bottom:16px;z-index:50;display:flex;gap:4px;padding:4px;border-radius:12px;background:#12142a;box-shadow:0 8px 24px rgba(0,0,0,.3);font:600 14px system-ui,sans-serif';
        [['', 'White'], ['mist', 'Mist'], ['stone', 'Stone'], ['navy', 'Navy']].forEach(([id, label]) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = label;
          b.style.cssText = 'border:0;border-radius:9px;padding:8px 12px;cursor:pointer;color:#fff;background:transparent';
          const paint = () => (b.style.background = (document.documentElement.dataset.bg || '') === id ? '#3a3fc4' : 'transparent');
          b.addEventListener('click', () => {
            if (id) document.documentElement.dataset.bg = id; else delete document.documentElement.dataset.bg;
            history.replaceState(null, '', id ? '?bg=' + id : location.pathname);
            bar.querySelectorAll('button').forEach((x) => x.dispatchEvent(new Event('paint')));
          });
          b.addEventListener('paint', paint);
          paint();
          bar.appendChild(b);
        });
        document.body.appendChild(bar);
      });
    })();
  </script>
  <Header />

  <main id="top" tabindex="-1">
    <!-- HERO: the niche and the problem in the headline, a real shop, and the
         product shown working on top of it. -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker">For barbershops, salons &amp; auto shops in the San Fernando Valley</p>
          <h1>Stop losing customers to missed calls and no-shows.</h1>
          <p class="lede">
            We set up automatic text-backs, appointment reminders and review requests for your business,
            and show it all on one simple screen. One fixed price. Yours to keep.
          </p>
          <div class="ctas">
            <a class="btn btn-primary btn-lg" href="#contact" data-to-form>Book a free audit</a>
            <a class="call-line" href="tel:+18189397964">or call or text <b>(818) 939-7964</b></a>
          </div>
          <ul class="checks">
            <li>Free 30-minute visit to your shop</li>
            <li>Try it working before you pay</li>
            <li>No monthly contract</li>
          </ul>
        </div>
        <div class="hero-media">
          <!-- generated photo (Z-Image Turbo, Apache 2.0): not a real shop or real people -->
          <img
            src="/img/hero-shop.jpg"
            srcset="/img/hero-shop-640.jpg 640w, /img/hero-shop.jpg 960w"
            sizes="(max-width: 900px) 100vw, 520px"
            alt="A barber giving a client a fade in a busy neighborhood barbershop while two customers wait"
            width="960"
            height="1147"
            fetchpriority="high"
          />
          <!-- the product, shown working: an example text-back and review -->
          <div class="chip sms" aria-hidden="true">
            <span class="chip-k">Missed call · texted back</span>
            "Sorry we missed you! Book your next cut here: valleyfades.com/book"
          </div>
          <div class="chip review" aria-hidden="true">
            <span class="stars">★★★★★</span>
            <span>New Google review</span>
          </div>
        </div>
      </div>
    </section>

    <!-- phones: the form right under the hero, where an ad click lands -->
    <div class="wrap phone-form" id="start">
      <LeadForm id="hf" title="Book your free audit" />
    </div>

    <!-- WHO IT'S FOR -->
    <section class="niches" aria-labelledby="niches-h">
      <div class="wrap">
        <h2 id="niches-h" class="h-sm">Made for businesses that run on appointments and walk-ins</h2>
        <ul class="niche-grid">
          {
            niches.map((n) => (
              <li>
                <img src={n.img} alt="" loading="lazy" width="560" height="700" />
                <span>{n.label}</span>
              </li>
            ))
          }
          <li class="niche-any"><span>Any appointment or walk-in business</span></li>
        </ul>
      </div>
    </section>

    <!-- WHAT IT FIXES: each problem in the owner's words, then what we set up -->
    <section id="how" class="fixes">
      <div class="wrap">
        <div class="head">
          <p class="kicker">How it works</p>
          <h2>The busywork that costs you customers, handled automatically.</h2>
        </div>

        <div class="fix">
          <div class="fix-copy">
            <h3>Missed calls shouldn't mean missed bookings.</h3>
            <p>
              When you're with a client and can't pick up, the caller gets a text with your booking link
              within seconds, instead of calling the shop down the street.
            </p>
            <p class="fix-tag">Missed-call text-back</p>
          </div>
          <div class="phone" aria-label="Example text messages after a missed call">
            <div class="ph-top"><b>Valley Fades</b><span>Example</span></div>
            <p class="sys">Missed call · 2:14 PM</p>
            <p class="out">Hi, it's Valley Fades. Sorry we missed you! Book your next cut here: valleyfades.com/book</p>
            <p class="in extra">Thanks, just booked Thursday at 4</p>
          </div>
        </div>

        <div class="fix flip">
          <div class="fix-copy">
            <h3>No-shows leave chairs empty.</h3>
            <p>
              Every booking gets a confirmation and a reminder the day before. Clients confirm or reschedule
              with one reply, so you can fill the gap.
            </p>
            <p class="fix-tag">Booking reminders</p>
          </div>
          <div class="phone" aria-label="Example appointment reminder text">
            <div class="ph-top"><b>Valley Fades</b><span>Example</span></div>
            <p class="out">Reminder: your fade with Marcos is tomorrow at 10:00 AM. Reply C to confirm or R to reschedule.</p>
            <p class="in">C</p>
            <p class="out extra">You're confirmed. See you tomorrow!</p>
          </div>
        </div>

        <div class="fix">
          <div class="fix-copy">
            <h3>Happy customers rarely leave reviews on their own.</h3>
            <p>
              After each visit, a thank-you text asks for a review with a direct link. More reviews means
              you show up higher when people nearby search.
            </p>
            <p class="fix-tag">Review requests</p>
          </div>
          <div class="phone" aria-label="Example review request text">
            <div class="ph-top"><b>Valley Fades</b><span>Example</span></div>
            <p class="out">Thanks for coming in today, Chris! Would you leave us a quick Google review? It really helps: g.page/valleyfades</p>
            <div class="ph-review"><span class="stars">★★★★★</span>New review posted</div>
          </div>
        </div>

        <div class="fix flip">
          <div class="fix-copy">
            <h3>Regulars drift away without a nudge.</h3>
            <p>
              A few weeks after each visit, clients get a friendly "time for your next one?" text with
              their usual time, so regulars stay regular.
            </p>
            <p class="fix-tag">Rebooking nudges</p>
          </div>
          <div class="phone" aria-label="Example rebooking text">
            <div class="ph-top"><b>Valley Fades</b><span>Example</span></div>
            <p class="out">Hey Luis, it's been 4 weeks since your last cut. Want your usual Saturday 11 AM? Book: valleyfades.com/book</p>
            <p class="in extra">Yes please</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ONE SCREEN: the dashboard, shown plainly -->
    <section class="board">
      <div class="wrap board-grid">
        <div>
          <p class="kicker">Your dashboard</p>
          <h2>See your day on one screen.</h2>
          <p class="lede">
            Bookings, takings, missed calls and new reviews, in one place you can check from your phone.
            We build it around what you want to see, and every business gets a different set.
          </p>
        </div>
        <div class="dash" aria-label="Example dashboard for a barbershop">
          <div class="dash-top"><b>Today at the shop</b><span>Example · Thu</span></div>
          <div class="tiles">
            <div><b>23</b><span>cuts today</span></div>
            <div><b class="g">$640</b><span>taken today</span></div>
            <div><b>3</b><span>missed calls texted back</span></div>
            <div><b>+4</b><span>new reviews this week</span></div>
          </div>
          <ul class="sched">
            <li><i>10:00</i><span>Marcos · fade</span><em class="ok">Confirmed</em></li>
            <li><i>10:30</i><span>Walk-in · beard trim</span><em>Walk-in</em></li>
            <li><i>11:00</i><span>Chris · kid's cut</span><em class="new">Booked online</em></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PRICING: shown openly, framed against monthly subscriptions -->
    <section id="pricing" class="pricing">
      <div class="wrap">
        <div class="head">
          <p class="kicker">Pricing</p>
          <h2>Pay once. It's yours.</h2>
          <p class="lede">
            Most text-back tools are a monthly subscription. Ours is a one-time build, with optional care.
            These are typical ranges; after your free audit you get a fixed quote before any work starts.
          </p>
        </div>
        <div class="plans">
          <div class="plan">
            <h3>Starter</h3>
            <p class="what">Dashboard + 1 automation</p>
            <p class="price">$400–$800</p>
            <p class="care">Optional care: about $49/mo</p>
            <ul>
              <li>1 automation, such as booking + reminders</li>
            </ul>
            <a class="btn" href="#contact" data-to-form>Get a quote</a>
          </div>
          <div class="plan hot">
            <p class="badge">Most popular</p>
            <h3>Standard</h3>
            <p class="what">Dashboard + 3 automations</p>
            <p class="price">$1,000–$1,800</p>
            <p class="care">Optional care: about $99/mo</p>
            <ul>
              <li>3 automations, such as text-back, reminders and reviews</li>
              <li>Weekly numbers email</li>
            </ul>
            <a class="btn btn-primary" href="#contact" data-to-form>Get a quote</a>
          </div>
          <div class="plan">
            <h3>Growth</h3>
            <p class="what">Dashboard + up to 5 automations</p>
            <p class="price">$1,800–$3,000</p>
            <p class="care">Optional care: about $179/mo</p>
            <ul>
              <li>Up to 5 automations</li>
              <li>With care: 1 new automation each month</li>
            </ul>
            <a class="btn" href="#contact" data-to-form>Get a quote</a>
          </div>
        </div>
        <div class="extras">
          <div>
            <h3>Websites</h3>
            <p>
              One page with hours, prices, booking and map: <b>$300–$600</b>. Up to 5 pages:
              <b>$600–$1,200</b>. Or <b>$0 down</b> at about $59/mo with hosting and edits included.
            </p>
          </div>
          <div>
            <h3>App cleanup</h3>
            <p>
              Already have an app that's slow or buggy? We fix it instead of starting over. Typically
              <b>$1,500–$4,000</b>, fixed quote after a free review.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS: a real sequence, so it gets numbers -->
    <section class="steps-sec">
      <div class="wrap">
        <h2 class="h-sm">Three steps, no surprises</h2>
        <ol class="steps">
          <li><b>Free audit</b><span>We visit your shop for 30 minutes and see where customers slip through.</span></li>
          <li><b>Working demo</b><span>You try your texts and dashboard before you pay anything.</span></li>
          <li><b>Go live</b><span>We switch it on and check in after. Add care if you want us to keep watch.</span></li>
        </ol>
      </div>
    </section>

    <!-- WHY US: the three ways a shop handles what it can't get to, side by side -->
    <section id="why" class="why">
      <div class="wrap">
        <div class="head">
          <p class="kicker">Why owners choose this</p>
          <h2>Better than voicemail. Cheaper than a front desk.</h2>
          <p class="lede">What happens to the calls, bookings and reviews you can't get to, three ways.</p>
        </div>
        <table class="compare">
          <thead>
            <tr>
              <th scope="col"><span class="sr">What happens</span></th>
              <th scope="col">Voicemail</th>
              <th scope="col">Front-desk help</th>
              <th scope="col" class="us">FutureClarity</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">A call you can't pick up</th>
              <td data-l="Voicemail">Many callers hang up and call the next shop</td>
              <td data-l="Front desk">Answered while someone's on shift</td>
              <td data-l="FutureClarity" class="us">Texted your booking link within seconds, day or night</td>
            </tr>
            <tr>
              <th scope="row">Appointment reminders</th>
              <td data-l="Voicemail">Only if you remember to send them</td>
              <td data-l="Front desk">When they have a spare minute</td>
              <td data-l="FutureClarity" class="us">Sent for every booking, automatically</td>
            </tr>
            <tr>
              <th scope="row">Asking for reviews</th>
              <td data-l="Voicemail">Rarely happens</td>
              <td data-l="Front desk">Sometimes, if they remember</td>
              <td data-l="FutureClarity" class="us">A thank-you text after every visit</td>
            </tr>
            <tr>
              <th scope="row">Bringing regulars back</th>
              <td data-l="Voicemail">Up to the client</td>
              <td data-l="Front desk">Hard to keep track of</td>
              <td data-l="FutureClarity" class="us">A nudge when they're due</td>
            </tr>
            <tr>
              <th scope="row">What it costs</th>
              <td data-l="Voicemail">Free, but you lose bookings</td>
              <td data-l="Front desk">Wages, every week</td>
              <td data-l="FutureClarity" class="us">One fixed price from $400, yours to keep</td>
            </tr>
          </tbody>
        </table>
        <p class="past">
          Past work you can check:
          <a href="https://www.thewhitesquirrelllc.com/" target="_blank" rel="noopener noreferrer">The White Squirrel ↗</a>
          (a gift shop's website) ·
          <a href="https://apps.apple.com/us/app/captain-fripps-lost-treasures/id6752260563" target="_blank" rel="noopener noreferrer"
            >Captain Fripp's Lost Treasures ↗</a
          >
          (an iOS app)
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq">
      <div class="wrap faq-grid">
        <div>
          <p class="kicker">FAQ</p>
          <h2>Questions owners ask us</h2>
          <p class="lede">Something else? Call or text <a href="tel:+18189397964">(818) 939-7964</a>.</p>
        </div>
        <div class="qs">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="contact">
      <div class="wrap contact-grid">
        <div>
          <p class="kicker">Get started</p>
          <h2>Book your free audit.</h2>
          <p class="lede">
            30 minutes at your business, no obligation. Send this and we'll call or text within one business
            day to pick a time.
          </p>
          <div class="direct">
            <p><span>Call or text</span><a href="tel:+18189397964">(818) 939-7964</a></p>
            <p>
              <span>Email</span><a href="mailto:beng@futureclaritytechnologies.com"
                >beng@futureclaritytechnologies.com</a
              >
            </p>
          </div>
        </div>
        <LeadForm id="cf" />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline src="/fc-config.js"></script>
<script is:inline src="/fc-store.js"></script>

<script>
  // ---- in-page navigation -------------------------------------------------
  const header = document.querySelector('header')!;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = () => window.matchMedia('(max-width: 640px)').matches;

  function goTo(id: string) {
    let y = 0;
    if (id !== '#top') {
      const sec = document.querySelector(id);
      if (!sec) return false;
      y = sec.getBoundingClientRect().top + window.pageYOffset - header.getBoundingClientRect().height - 12;
    }
    window.scrollTo({ top: Math.max(0, y), behavior: reduce ? 'auto' : 'smooth' });
    return true;
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
    if (!a || a.classList.contains('skip')) return;
    let id = a.getAttribute('href');
    if (!id || id.length < 2) return;
    // "Book a free audit" buttons go to the nearest form: on phones, the one under the hero.
    const toForm = a.hasAttribute('data-to-form') || id === '#contact';
    if (toForm && phone()) id = '#start';
    if (!goTo(id)) return;
    e.preventDefault();
    if (toForm) {
      const input = document.getElementById(id === '#start' ? 'hf-name' : 'cf-name');
      setTimeout(() => input?.focus({ preventScroll: true }), reduce ? 0 : 650);
    }
  });

  // Highlight the section you are in.
  const links = Array.from(document.querySelectorAll('header nav a'));
  const secs = links.map((a) => document.querySelector(a.getAttribute('href') || ''));
  function mark() {
    const line = header.getBoundingClientRect().height + 40;
    let cur = -1;
    secs.forEach((s, i) => {
      if (s && s.getBoundingClientRect().top <= line) cur = i;
    });
    links.forEach((a, i) => a.classList.toggle('on', i === cur));
  }
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        mark();
      });
    },
    { passive: true }
  );
  mark();

  // ---- header call to action ---------------------------------------------
  // On a phone the header holds Call to begin with, and a Free audit button
  // once neither form is on screen.
  if ('IntersectionObserver' in window) {
    const onScreen = new Map<Element, boolean>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => onScreen.set(e.target, e.isIntersecting));
      header.classList.toggle('cta-on', ![...onScreen.values()].some(Boolean));
    });
    document.querySelectorAll('form[data-lead]').forEach((f) => io.observe(f));
  }

  // ---- where the visitor came from -----------------------------------------
  // Ad links carry utm_* tags or a click id; other sites show up as the
  // referrer. Saved for 30 days and sent with the request as scope.src.
  const SRC_KEY = 'fc-src';
  const SRC_DAYS = 30;
  const TAGS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'msclkid'];

  function readSource(): Record<string, string> | null {
    const q = new URLSearchParams(window.location.search);
    const now: Record<string, string> = {};
    TAGS.forEach((k) => {
      const v = q.get(k);
      if (v) now[k] = v.slice(0, 200);
    });
    try {
      const r = new URL(document.referrer);
      if (r.host && r.host !== window.location.host) now.ref = r.host.slice(0, 100);
    } catch {}

    let saved: Record<string, string> | null = null;
    try { saved = JSON.parse(localStorage.getItem(SRC_KEY) || 'null'); } catch {}
    if (saved && Date.now() - Date.parse(saved.at || '') > SRC_DAYS * 864e5) saved = null;

    const isAd = TAGS.some((k) => now[k]);
    if (isAd || (!saved && now.ref)) {
      saved = { ...now, at: new Date().toISOString() };
      try { localStorage.setItem(SRC_KEY, JSON.stringify(saved)); } catch {}
    }
    return saved;
  }
  const source = readSource();

  // ---- what visitors do ----------------------------------------------------
  // Sent to Google Analytics only if the visitor allowed it (Consent.astro).
  // Never include names, phone numbers or emails here.
  const track = (name: string, params: Record<string, unknown> = {}) => (window as any).fcTrack?.(name, params);
  const placeOf = (el: Element) => el.closest('header, footer, section, .phone-form')?.className.split(' ')[0] || 'page';

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a') as HTMLAnchorElement | null;
    if (!a) return;
    const href = a.getAttribute('href') || '';
    if (href.startsWith('tel:')) track('phone_click', { place: placeOf(a) });
    else if (href.startsWith('mailto:')) track('email_click', { place: placeOf(a) });
    else if (a.hasAttribute('data-to-form') || href.endsWith('#contact')) track('cta_click', { place: placeOf(a), label: (a.textContent || '').trim().slice(0, 40) });
    else if (a.target === '_blank') track('outbound_click', { url: a.href.slice(0, 100) });
  });
  document.querySelectorAll('#faq details').forEach((d) =>
    d.addEventListener('toggle', () => {
      if ((d as HTMLDetailsElement).open) track('faq_open', { question: (d.querySelector('summary')?.textContent || '').slice(0, 80) });
    })
  );
  // How far people read: each main section, once, when most of it is on screen.
  if ('IntersectionObserver' in window) {
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          track('view_section', { section: en.target.id });
          seen.unobserve(en.target);
        }),
      { threshold: 0.35 }
    );
    ['how', 'pricing', 'why', 'faq', 'contact'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) seen.observe(el);
    });
  }

  // ---- lead forms ---------------------------------------------------------
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form[data-lead]'));
  const BOOKED_KEY = 'fc-booked';

  // Team shortcut: typing the dashboard code as the whole note opens
  // /dashboard/ instead of booking. The code is checked by the database
  // (supabase/dashboard_code.sql); only a short single-word note is checked.
  const CODE_KEY = 'fc-dashboard-code';
  async function tryDashboardCode(text: string) {
    const t = text.trim();
    if (t.length < 6 || t.length > 64 || /\s/.test(t)) return false;
    const cfg = (window as any).FC_CONFIG;
    if (!cfg?.supabaseUrl || !cfg?.supabaseKey) return false;
    try {
      const res = await fetch(cfg.supabaseUrl.replace(/\/$/, '') + '/rest/v1/rpc/dashboard_check', {
        method: 'POST',
        headers: { apikey: cfg.supabaseKey, Authorization: `Bearer ${cfg.supabaseKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: t }),
      });
      if (!res.ok || (await res.json()) !== true) return false;
      try { localStorage.setItem(CODE_KEY, t); } catch {}
      return true;
    } catch {
      return false;
    }
  }

  // ---- phone or email ------------------------------------------------------
  type Via = 'phone' | 'email';
  const viaOf = (f: HTMLFormElement): Via =>
    f.querySelector<HTMLInputElement>('input[name="via"]:checked')?.value === 'email' ? 'email' : 'phone';
  // A phone number with its area code, or something shaped like an email address.
  const reachable = (via: Via, s: string) =>
    via === 'email' ? /^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(s) : s.replace(/\D/g, '').length >= 10;

  document.querySelectorAll<HTMLElement>('[data-via-group]').forEach((g) => {
    g.addEventListener('change', (e) => {
      const r = e.target as HTMLInputElement;
      if (r.name !== 'via') return;
      g.querySelectorAll<HTMLInputElement>('input[name="phone"], input[name="email"]').forEach((i) => {
        i.hidden = i.name !== r.value;
        i.removeAttribute('aria-invalid');
      });
    });
  });

  // Both forms switch to the thank-you, so nobody sends the same request twice.
  function showDone(name: string, focus?: HTMLFormElement) {
    forms.forEach((f) => {
      f.querySelector<HTMLElement>('.lead-fields')!.hidden = true;
      const done = f.querySelector<HTMLElement>('.lead-done')!;
      done.hidden = false;
      const first = name.split(' ')[0];
      if (first) done.querySelector('[data-done-title]')!.textContent = `Thanks, ${first}. We've got it.`;
    });
    focus?.querySelector<HTMLElement>('.lead-done')?.focus();
  }

  try {
    const booked = sessionStorage.getItem(BOOKED_KEY);
    if (booked !== null) showDone(booked);
  } catch {}

  forms.forEach((form) => {
    form.addEventListener('focusin', () => track('form_start', { form: form.id }), { once: true });
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const val = (name: string) => el(name).value.trim();
    const err = form.querySelector<HTMLElement>('.formerr')!;
    const fail = form.querySelector<HTMLElement>('.sendfail')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    let sending = false;

    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));

    form.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;

      if (await tryDashboardCode(val('msg'))) {
        window.location.href = '/dashboard/';
        return;
      }

      const via = viaOf(form);
      const bad = ['name', 'business', via].filter((n) => {
        const v = val(n);
        const wrong = !v || (n === via && !reachable(via, v));
        el(n).setAttribute('aria-invalid', wrong ? 'true' : 'false');
        return wrong;
      });
      if (bad.length) {
        err.hidden = false;
        el(bad[0]).focus();
        return;
      }
      err.hidden = true;

      const name = val('name');
      // A filled honeypot is a bot: look sent, send nothing.
      if (val('company_site')) {
        showDone(name, form);
        return;
      }

      const picked = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-pick][aria-pressed="true"]'));
      const keys = picked.map((b) => b.dataset.pick || '');
      const labels = picked.map((b) => b.textContent || '');
      const needs = [labels.length ? 'Interested in: ' + labels.join(', ') : '', val('msg')].filter(Boolean).join('\n');
      const payload = {
        name,
        business: val('business'),
        contact: val(via),
        needs,
        scope: {
          wf: keys.filter((k) => k !== 'website' && k !== 'app'),
          site: '',
          app: keys.includes('app'),
          care: false,
          ...(source ? { src: source } : {}),
        },
      };

      // If saving fails, the email and text buttons carry the request instead.
      const body = `Name: ${payload.name}\nBusiness: ${payload.business}\nPhone or email: ${payload.contact}${needs ? '\n' + needs : ''}`;
      const subject = 'Free audit request: ' + payload.business;
      form.querySelector<HTMLAnchorElement>('[data-mail]')!.href =
        'mailto:beng@futureclaritytechnologies.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      form.querySelector<HTMLAnchorElement>('[data-sms]')!.href = 'sms:+18189397964?&body=' + encodeURIComponent(subject + '\n' + body);

      sending = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        await (window as any).FCStore.submit(payload);
        try { sessionStorage.setItem(BOOKED_KEY, name); } catch {}
        fail.hidden = true;
        showDone(name, form);
        track('generate_lead', { form: form.id, contact_by: via, interests: keys.join(',') || 'none' });
      } catch {
        btn.textContent = 'Try again';
        fail.hidden = false;
      }
      sending = false;
      btn.disabled = false;
    });
  });
</script>
