---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';

// Asking for a free quote is one step on every screen size: LeadForm sends the
// request straight to Supabase (public/fc-store.js). Phones get the form right
// under the hero as well, where ad clicks land.

// What we do. No prices anywhere on the site: every project starts with a free
// consultation and a free quote.
const services = [
  {
    title: 'Websites',
    text: 'New sites that look sharp on every phone, load fast, and make it easy to call, book or buy.',
    items: ['Designed around your business', 'Booking, menus, stores and forms', 'Built to show up on Google'],
  },
  {
    title: 'Apps',
    text: 'iPhone, Android and web apps, from the first sketch to the App Store.',
    items: ['Apps for your customers or your team', 'Accounts, payments and notifications', 'Published and kept up to date'],
  },
  {
    title: 'Fixes & redesigns',
    text: "A site or app that's slow, broken or dated? We fix what's there, or rebuild it when that's smarter.",
    items: ['Bugs, speed and phone layouts', 'Projects other developers left behind', 'Fresh designs that keep your content'],
  },
  {
    title: 'SEO',
    text: 'Help the people searching nearby find you, and pick you.',
    items: ['Fast pages and clean code', 'Page titles, descriptions and local search', 'Your Google listing set up properly'],
  },
  {
    title: 'Hosting, moves & edits',
    text: 'We host and look after your site, move it off an old host, and make changes when you ask.',
    items: ['Fast, secure hosting', 'Moves from Wix, Squarespace, GoDaddy and more', 'New photos, hours, text and pages'],
  },
  {
    title: 'Automations',
    text: 'The busywork that eats your day, handled automatically.',
    items: ['Missed-call text-backs', 'Booking reminders and review requests', 'Built around the tools you already use'],
  },
];

const faqs = [
  {
    q: 'How much does a website or app cost?',
    a: "It depends on what you need. Tell us about your project and we'll give you a free quote before any work starts. No obligation.",
  },
  {
    q: 'Can you fix or update a site or app someone else built?',
    a: "Yes. We take over existing websites and apps, fix what's broken, speed them up and keep them updated. If rebuilding would be cheaper than patching, we'll tell you.",
  },
  {
    q: 'Can you move my site to a new host?',
    a: 'Yes. We move sites and domains from Wix, Squarespace, GoDaddy, WordPress hosts and others, then check that everything still works afterward.',
  },
  {
    q: 'Do you do SEO?',
    a: "Yes: fast pages, clear page titles and descriptions, local search and your Google listing. Nobody honest can promise you the #1 spot on Google, and we won't.",
  },
  {
    q: 'Do you build apps for iPhone and Android?',
    a: 'Yes, plus web apps that run in the browser. We can also take over an app you already have and keep it updated.',
  },
  {
    q: 'Do you still do automations?',
    a: 'Yes. Missed-call text-backs, appointment reminders, review requests and more, built around the tools you already use, like Square, Booksy or Vagaro.',
  },
  {
    q: 'Where do you work?',
    a: "We're based in the San Fernando Valley and work with businesses anywhere by phone and video. If you're local, we're happy to meet in person.",
  },
];

// The hero picture: AVIF where supported, WebP otherwise, three widths.
const heroSizes = '(max-width: 900px) 170vw, 100vw';
const heroSet = (ext: string) => [900, 1400, 1774].map((w) => `/img/hero-devices-${w}.${ext} ${w}w`).join(', ');
---

<Layout title="FutureClarity Technologies · Websites, Apps & SEO" main="#top">
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroSet('avif')}
    imagesizes={heroSizes}
    fetchpriority="high"
  />
  <link slot="head" rel="preload" href="/fonts/barlow-condensed-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />

  <Header />

  <main id="top" tabindex="-1">
    <!-- HERO: the company name, what we do, and a sample website and app beside it -->
    <section class="light-hero" id="hero" aria-labelledby="hero-title">
      <!-- Decorative: made-up businesses (Northside Dental, Ironwood) shown as examples of our work.
           The caption below says so, which keeps the mockups from reading as client claims. -->
      <div class="hero-art" aria-hidden="true">
        <picture>
          <source type="image/avif" srcset={heroSet('avif')} sizes={heroSizes} />
          <img
            src="/img/hero-devices-1400.webp"
            srcset={heroSet('webp')}
            sizes={heroSizes}
            alt=""
            width="1774"
            height="887"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="kicker">Web &amp; app development · San Fernando Valley</p>
          <h1 class="hero-title" id="hero-title">
            <span>Future</span><span class="outline">Clarity</span><small>Technologies</small>
          </h1>
          <h2>Websites and apps,<br />built right and<br />kept running.</h2>
          <p class="hero-description">
            We build new sites and apps, fix the ones you have, and handle the rest: SEO, hosting, moving hosts and
            everyday edits. We automate the busywork too.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#contact" data-to-form>Get a free quote <span class="arrow" aria-hidden="true">→</span></a>
            <span class="hero-call">or call or text <a href="tel:+18185850475">(818) 585-0475</a></span>
          </div>
          <ul class="hero-checks">
            <li>Free consultation</li>
            <li>Free quote before any work starts</li>
            <li>One team for build, fixes and upkeep</li>
          </ul>
        </div>
      </div>
      <!-- A real customer review, quoted with ellipses where words were left out. Keep it word for word
           from the Yelp review; don't add to it or change its meaning (FTC endorsement rules). -->
      <figure class="review-card" aria-label="Five-star review from Jen W. on Yelp">
        <span class="rv-yelp">Yelp</span>
        <div>
          <p class="rv-head">
            <span class="rv-stars" role="img" aria-label="5 out of 5 stars">★★★★★</span><span>5-star review</span>
          </p>
          <blockquote>
            <p>
              “…handled the entire process… and got everything completed in just one day… professional, responsive, and
              efficient throughout the entire process.”
            </p>
          </blockquote>
          <p class="rv-by">— Jen W.</p>
        </div>
      </figure>
      <p class="example-caption">Illustrative website &amp; app concepts</p>
    </section>
    <div class="hero-bottom">
      <div class="wrap">
        <span><i aria-hidden="true"></i>Built locally.&nbsp;<b>Ready for anywhere.</b></span>
        <span>Websites · Apps · Automations</span>
        <span>From the first idea to everyday upkeep</span>
      </div>
    </div>

    <!-- phones: the form right under the hero, where an ad click lands -->
    <div class="phone-form" id="start">
      <div class="wrap"><LeadForm id="hf" title="Get your free quote" /></div>
    </div>

    <!-- WHAT WE DO -->
    <section id="services" class="sec white services">
      <div class="wrap">
        <div class="head">
          <p class="kicker" data-rv>What we do</p>
          <h2 data-rv="px">Websites and apps, and everything that keeps them working.</h2>
          <p class="lede" data-rv style="--i:1">
            Start with one thing or hand us all of it. Every project starts with a free consultation and a free quote.
          </p>
        </div>
        <ul class="svc-grid">
          {
            services.map((s, i) => (
              <li class="svc" data-rv style={`--i:${i % 3}`}>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <ul>
                  {s.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- AUTOMATIONS: still part of what we do, shown with one example -->
    <section id="automations" class="sec night auto">
      <div class="wrap fix">
        <div class="fix-copy">
          <p class="kicker" data-rv>Automations</p>
          <h2 data-rv="px">We automate the busywork, too.</h2>
          <p data-rv style="--i:1">
            When you can't pick up, callers get a text with your booking link. Every booking gets a reminder, and happy
            customers get a quick review request. It runs on its own, built around the tools you already use.
          </p>
          <ul class="tags" data-rv style="--i:2">
            <li>Missed-call text-back</li>
            <li>Booking reminders</li>
            <li>Review requests</li>
            <li>Rebooking nudges</li>
          </ul>
        </div>
        <div class="phone" id="phoneDemo" role="img" aria-label="Example: after a missed call, the business texts a booking link and the caller replies that they booked">
          <div class="ph-top"><b>Northside Dental</b><span>Example</span></div>
          <p class="sys">Missed call · 2:14 PM</p>
          <p class="msg-out">Hi, it's Northside Dental. Sorry we missed your call! Book your visit here: northsidedental.com/book</p>
          <p class="msg-in">Thanks, just booked Thursday at 1:15</p>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS: a real sequence, so it gets numbers -->
    <section id="how" class="sec steps-sec">
      <div class="wrap">
        <div class="head center">
          <p class="kicker" data-rv>How it works</p>
          <h2 data-rv="px">From first call to launch, no surprises.</h2>
        </div>
        <ol class="steps">
          <li data-rv style="--i:0"><b>Free consultation</b><span>Tell us what you need by phone, video or in person. We'll ask questions and give you honest advice.</span></li>
          <li data-rv style="--i:1"><b>Free quote</b><span>You get a clear quote before any work starts. No obligation.</span></li>
          <li data-rv style="--i:2"><b>We build it</b><span>We keep you posted as we go, and you review everything before it goes live.</span></li>
          <li data-rv style="--i:3"><b>We keep it running</b><span>Hosting, edits and fixes after launch, if you want us to look after it.</span></li>
        </ol>
      </div>
    </section>

    <!-- WHY US -->
    <section id="why" class="sec night why">
      <div class="wrap">
        <div class="head">
          <p class="kicker" data-rv>Why FutureClarity</p>
          <h2 data-rv="px">A local team that picks up the phone.</h2>
        </div>
        <ul class="why-grid">
          <li data-rv style="--i:0"><b>One team for all of it</b><span>Design, code, SEO, hosting and fixes in one place, so nothing falls between vendors.</span></li>
          <li data-rv style="--i:1"><b>Plain answers</b><span>We explain things without the jargon, and you get a quote before any work starts.</span></li>
          <li data-rv style="--i:2"><b>You own what we build</b><span>Your domain, your site, your app and your accounts stay yours.</span></li>
          <li data-rv style="--i:3"><b>Easy to reach</b><span>Based in the San Fernando Valley. Call or text <a href="tel:+18185850475">(818) 585-0475</a>.</span></li>
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="sec faq">
      <div class="wrap faq-grid">
        <div>
          <p class="kicker" data-rv>FAQ</p>
          <h2 data-rv="px">Questions people ask us</h2>
          <p class="lede" data-rv style="--i:1">Something else? Call or text <a href="tel:+18185850475">(818) 585-0475</a>.</p>
        </div>
        <div class="qs">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="sec white contact">
      <div class="wrap contact-grid">
        <div>
          <p class="kicker" data-rv>Get started</p>
          <h2 data-rv="px">Get your free quote.</h2>
          <p class="lede" data-rv style="--i:1">
            Tell us a little about your project. We'll call or text within one business day to set up a free
            consultation. No obligation.
          </p>
          <div class="direct" data-rv style="--i:2">
            <p><span>Call or text</span><a href="tel:+18185850475">(818) 585-0475</a></p>
            <p>
              <span>Email</span><a href="mailto:beng@futureclaritytechnologies.com">beng@futureclaritytechnologies.com</a>
            </p>
          </div>
        </div>
        <LeadForm id="cf" title="Tell us about your project" />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline src="/fc-config.js"></script>
<script is:inline src="/fc-store.js"></script>

<script>
  // ---- in-page navigation -------------------------------------------------
  const header = document.querySelector('.site-head')!;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const phone = () => window.matchMedia('(max-width: 640px)').matches;

  function goTo(id: string) {
    let y = 0;
    if (id !== '#top') {
      const sec = document.querySelector(id);
      if (!sec) return false;
      y = sec.getBoundingClientRect().top + window.pageYOffset - header.getBoundingClientRect().height - 12;
    }
    window.scrollTo({ top: Math.max(0, y), behavior: reduce ? 'auto' : 'smooth' });
    return true;
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
    if (!a || a.classList.contains('skip')) return;
    let id = a.getAttribute('href');
    if (!id || id.length < 2) return;
    // "Get a free quote" buttons go to the nearest form: on phones, the one under the hero.
    const toForm = a.hasAttribute('data-to-form') || id === '#contact';
    if (toForm && phone()) id = '#start';
    if (!goTo(id)) return;
    e.preventDefault();
    if (toForm) {
      const input = document.getElementById(id === '#start' ? 'hf-name' : 'cf-name');
      setTimeout(() => input?.focus({ preventScroll: true }), reduce ? 0 : 650);
    }
  });

  // Highlight the section you are in.
  const links = Array.from(document.querySelectorAll('.site-head .bar nav a'));
  const secs = links.map((a) => document.querySelector(a.getAttribute('href') || ''));
  function mark() {
    const line = header.getBoundingClientRect().height + 40;
    let cur = -1;
    secs.forEach((s, i) => {
      if (s && s.getBoundingClientRect().top <= line) cur = i;
    });
    links.forEach((a, i) => a.classList.toggle('on', i === cur));
  }
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        mark();
      });
    },
    { passive: true }
  );
  mark();

  // ---- scroll reveals and the texting demo ---------------------------------
  // Only with IntersectionObserver and without reduced motion; otherwise
  // everything is simply visible (the CSS hides nothing without .js).
  if ('IntersectionObserver' in window && !reduce) {
    document.documentElement.classList.add('js');
    const rv = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          en.target.classList.add('in');
          rv.unobserve(en.target);
        }),
      { rootMargin: '0px 0px -35px 0px' }
    );
    // A heading that wipes in starts fully clipped, which never counts as visible,
    // so watch its parent instead.
    document.querySelectorAll<HTMLElement>('[data-rv]').forEach((el) => {
      if (el.dataset.rv !== 'px') return rv.observe(el);
      const parent = el.parentElement!;
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            el.classList.add('in');
            io.disconnect();
          }
        },
        { rootMargin: '0px 0px -35px 0px' }
      );
      io.observe(parent);
    });
    const demo = document.getElementById('phoneDemo');
    if (demo) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            demo.classList.add('in-view');
            io.disconnect();
          }
        },
        { threshold: 0.25 }
      );
      io.observe(demo);
    }
  }

  // ---- where the visitor came from -----------------------------------------
  // Ad links carry utm_* tags or a click id; other sites show up as the
  // referrer. Saved for 30 days and sent with the request as scope.src.
  const SRC_KEY = 'fc-src';
  const SRC_DAYS = 30;
  const TAGS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'msclkid'];

  function readSource(): Record<string, string> | null {
    const q = new URLSearchParams(window.location.search);
    const now: Record<string, string> = {};
    TAGS.forEach((k) => {
      const v = q.get(k);
      if (v) now[k] = v.slice(0, 200);
    });
    try {
      const r = new URL(document.referrer);
      if (r.host && r.host !== window.location.host) now.ref = r.host.slice(0, 100);
    } catch {}

    let saved: Record<string, string> | null = null;
    try { saved = JSON.parse(localStorage.getItem(SRC_KEY) || 'null'); } catch {}
    if (saved && Date.now() - Date.parse(saved.at || '') > SRC_DAYS * 864e5) saved = null;

    const isAd = TAGS.some((k) => now[k]);
    if (isAd || (!saved && now.ref)) {
      saved = { ...now, at: new Date().toISOString() };
      try { localStorage.setItem(SRC_KEY, JSON.stringify(saved)); } catch {}
    }
    return saved;
  }
  const source = readSource();

  // ---- what visitors do ----------------------------------------------------
  // Sent to Google Analytics only if the visitor allowed it (Consent.astro).
  // Never include names, phone numbers or emails here.
  const track = (name: string, params: Record<string, unknown> = {}) => (window as any).fcTrack?.(name, params);
  const placeOf = (el: Element) => el.closest('header, footer, section, .phone-form')?.className.split(' ')[0] || 'page';

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a') as HTMLAnchorElement | null;
    if (!a) return;
    const href = a.getAttribute('href') || '';
    if (href.startsWith('tel:')) track('phone_click', { place: placeOf(a) });
    else if (href.startsWith('mailto:')) track('email_click', { place: placeOf(a) });
    else if (a.hasAttribute('data-to-form') || href.endsWith('#contact')) track('cta_click', { place: placeOf(a), label: (a.textContent || '').trim().slice(0, 40) });
    else if (a.target === '_blank') track('outbound_click', { url: a.href.slice(0, 100) });
  });
  document.querySelectorAll('#faq details').forEach((d) =>
    d.addEventListener('toggle', () => {
      if ((d as HTMLDetailsElement).open) track('faq_open', { question: (d.querySelector('summary')?.textContent || '').slice(0, 80) });
    })
  );
  // How far people read: each main section, once, when most of it is on screen.
  if ('IntersectionObserver' in window) {
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          track('view_section', { section: en.target.id });
          seen.unobserve(en.target);
        }),
      { threshold: 0.35 }
    );
    ['services', 'automations', 'how', 'why', 'faq', 'contact'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) seen.observe(el);
    });
  }

  // ---- lead forms ---------------------------------------------------------
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form[data-lead]'));
  const BOOKED_KEY = 'fc-booked';

  // Team shortcut: type the dashboard code into any field of either form (name,
  // business or note), leave the phone/email empty, and press the button: it
  // opens /dashboard/ instead of sending a request. Spaces and capitals don't
  // matter; the database checks the code (supabase/dashboard_code.sql). Real
  // requests always have a phone or email, so they never go through this check.
  const CODE_KEY = 'fc-dashboard-code';
  async function tryDashboardCode(text: string) {
    const t = text.trim();
    const bare = t.replace(/\s/g, '');
    if (bare.length < 6 || t.length > 64) return false;
    const cfg = (window as any).FC_CONFIG;
    if (!cfg?.supabaseUrl || !cfg?.supabaseKey) return false;
    try {
      const res = await fetch(cfg.supabaseUrl.replace(/\/$/, '') + '/rest/v1/rpc/dashboard_check', {
        method: 'POST',
        headers: { apikey: cfg.supabaseKey, Authorization: `Bearer ${cfg.supabaseKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: t }),
      });
      if (!res.ok || (await res.json()) !== true) return false;
      try { localStorage.setItem(CODE_KEY, t); } catch {}
      return true;
    } catch {
      return false;
    }
  }

  // ---- phone or email ------------------------------------------------------
  type Via = 'phone' | 'email';
  const viaOf = (f: HTMLFormElement): Via =>
    f.querySelector<HTMLInputElement>('input[name="via"]:checked')?.value === 'email' ? 'email' : 'phone';
  // A phone number with its area code, or something shaped like an email address.
  const reachable = (via: Via, s: string) =>
    via === 'email' ? /^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(s) : s.replace(/\D/g, '').length >= 10;

  document.querySelectorAll<HTMLElement>('[data-via-group]').forEach((g) => {
    g.addEventListener('change', (e) => {
      const r = e.target as HTMLInputElement;
      if (r.name !== 'via') return;
      g.querySelectorAll<HTMLInputElement>('input[name="phone"], input[name="email"]').forEach((i) => {
        i.hidden = i.name !== r.value;
        i.removeAttribute('aria-invalid');
      });
    });
  });

  // Both forms switch to the thank-you, so nobody sends the same request twice.
  function showDone(name: string, focus?: HTMLFormElement) {
    forms.forEach((f) => {
      f.querySelector<HTMLElement>('.lead-fields')!.hidden = true;
      const done = f.querySelector<HTMLElement>('.lead-done')!;
      done.hidden = false;
      const first = name.split(' ')[0];
      if (first) done.querySelector('[data-done-title]')!.textContent = `Thanks, ${first}. We've got it.`;
    });
    focus?.querySelector<HTMLElement>('.lead-done')?.focus();
  }

  try {
    const booked = sessionStorage.getItem(BOOKED_KEY);
    if (booked !== null) showDone(booked);
  } catch {}

  forms.forEach((form) => {
    form.addEventListener('focusin', () => track('form_start', { form: form.id }), { once: true });
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const val = (name: string) => el(name).value.trim();
    const err = form.querySelector<HTMLElement>('.formerr')!;
    const fail = form.querySelector<HTMLElement>('.sendfail')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    let sending = false;

    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));

    form.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;

      if (!val('phone') && !val('email')) {
        for (const n of ['name', 'business', 'msg']) {
          if (val(n) && (await tryDashboardCode(val(n)))) {
            window.location.href = '/dashboard/';
            return;
          }
        }
      }

      const via = viaOf(form);
      const bad = ['name', 'business', via].filter((n) => {
        const v = val(n);
        const wrong = !v || (n === via && !reachable(via, v));
        el(n).setAttribute('aria-invalid', wrong ? 'true' : 'false');
        return wrong;
      });
      if (bad.length) {
        err.hidden = false;
        el(bad[0]).focus();
        return;
      }
      err.hidden = true;

      const name = val('name');
      // A filled honeypot is a bot: look sent, send nothing.
      if (val('company_site')) {
        showDone(name, form);
        return;
      }

      const picked = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-pick][aria-pressed="true"]'));
      const keys = picked.map((b) => b.dataset.pick || '');
      const labels = picked.map((b) => b.textContent || '');
      const needs = [labels.length ? 'Interested in: ' + labels.join(', ') : '', val('msg')].filter(Boolean).join('\n');
      // The picks travel as plain words in "needs". The dashboard prices scope.wf
      // as automation workflows, so nothing goes there; the team sets the scope
      // after the consultation.
      const payload = {
        name,
        business: val('business'),
        contact: val(via),
        needs,
        scope: {
          wf: [],
          site: '',
          app: keys.some((k) => k.startsWith('app')),
          care: false,
          ...(source ? { src: source } : {}),
        },
      };

      // If saving fails, the email and text buttons carry the request instead.
      const body = `Name: ${payload.name}\nBusiness: ${payload.business}\nPhone or email: ${payload.contact}${needs ? '\n' + needs : ''}`;
      const subject = 'Free quote request: ' + payload.business;
      form.querySelector<HTMLAnchorElement>('[data-mail]')!.href =
        'mailto:beng@futureclaritytechnologies.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      form.querySelector<HTMLAnchorElement>('[data-sms]')!.href = 'sms:+18185850475?&body=' + encodeURIComponent(subject + '\n' + body);

      sending = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        await (window as any).FCStore.submit(payload);
        try { sessionStorage.setItem(BOOKED_KEY, name); } catch {}
        fail.hidden = true;
        showDone(name, form);
        track('generate_lead', { form: form.id, contact_by: via, interests: keys.join(',') || 'none' });
      } catch {
        btn.textContent = 'Try again';
        fail.hidden = false;
      }
      sending = false;
      btn.disabled = false;
    });
  });
</script>
