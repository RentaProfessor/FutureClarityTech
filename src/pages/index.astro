---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Lead delivery. Formspree is the endpoint the previous site used and is kept
// as the live destination so no enquiry is lost during the redesign. When the
// Supabase env vars below are set at build time the form posts there instead,
// and Formspree stays as the fallback if that request fails.
//
// Before switching Supabase on, two things have to be true:
//   1. The leads table has row level security with an INSERT-only policy for
//      the anon role. The anon key ships in the page, so without that policy
//      anyone can read every lead back out.
//   2. public/_headers has the Supabase host in connect-src, or the browser
//      blocks the request under the existing Content-Security-Policy.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/movkledr';
---

<Layout title="FutureClarity Technologies | Dashboards & automations for local businesses">
  <Header />

  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <svg class="mark" viewBox="150 30 300 220" aria-hidden="true">
          <path
            class="lens-anim"
            d="M300,58 Q352,140 300,222 Q248,140 300,58 Z"
            fill="url(#lensFill)"
            filter="url(#lensGlow)"></path>
          <line
            class="beam-anim"
            x1="150"
            y1="194"
            x2="450"
            y2="86"
            stroke="url(#beamFill)"
            stroke-width="2.5"
            filter="url(#lensGlow)"></line>
        </svg>
        <div class="label c">Dashboards &amp; automations for local businesses</div>
        <h1>Your business, <span class="grad">on one dashboard.</span></h1>
        <p class="sub">
          We build you a custom dashboard and set up the automations behind it, around what your
          business needs. Bookings, reminders, reviews and follow-ups run on their own, and you see
          it all in one place.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="#contact">Book a free audit</a>
          <a class="btn" href="#how">See how it works</a>
        </div>
        <div class="who" aria-label="Who we work with">
          <span class="on">Barbershops &amp; salons</span><span>Auto repair &amp; detailing</span><span
          >Pet groomers</span><span>Tattoo studios</span><span>Fitness &amp; martial arts</span><span
          >Any appointment or walk-in business</span>
        </div>
        <div class="meta">
          <span>Free audit &amp; <b>fixed quote</b></span><span>Monthly care <b>optional</b></span><span
          >Demo <b>before you pay</b></span>
        </div>
      </div>
    </section>

    <!-- 01 HOW IT WORKS -->
    <section id="how" style="padding-top:40px">
      <div class="wrap">
        <div class="head">
          <div class="label">01 · How it works</div>
          <h2>A dashboard up front. Automations behind it.</h2>
          <p class="sub">
            You get one screen built for your business. Behind it, we set up the workflows that do
            the repeat work for you, connected to the tools you already use.
          </p>
        </div>
        <div class="fb">
          <div class="dash glass" aria-label="Example dashboard for a barbershop">
            <div class="side-label">
              <span>Front end · your dashboard</span><em>Example: a barbershop</em>
            </div>
            <div class="title"><b>Today at the shop</b><span>Thu · 4 chairs</span></div>
            <div class="tiles">
              <div class="tile"><b>23</b><span>cuts today</span></div>
              <div class="tile g"><b>$640</b><span>taken today</span></div>
              <div class="tile w"><b>3</b><span>missed calls, texted back</span></div>
              <div class="tile"><b>+4</b><span>new reviews this week</span></div>
            </div>
            <div class="sched">
              <div><i>10:00</i><span>Marcos · fade</span><em class="ok">Confirmed</em></div>
              <div><i>10:30</i><span>Walk-in · beard trim</span><em>Walk-in</em></div>
              <div><i>11:00</i><span>Chris · kid's cut</span><em class="new">Booked online</em></div>
              <div><i>11:30</i><span>Open chair · Luis</span><em>Rebook list: 17</em></div>
            </div>
          </div>
          <div class="back glass" aria-label="Automations running behind the dashboard">
            <div class="side-label"><span>Back end · your workflows</span></div>
            <div class="auto">
              <i>01</i>
              <div>
                Online booking + reminders
                <small>Confirms each booking and texts a reminder the day before.</small>
              </div>
            </div>
            <div class="auto">
              <i>02</i>
              <div>
                Missed-call text-back
                <small>Every missed caller gets a booking link in seconds.</small>
              </div>
            </div>
            <div class="auto">
              <i>03</i>
              <div>
                Review requests
                <small>A thank-you text with your review link after each visit.</small>
              </div>
            </div>
            <div class="auto">
              <i>04</i>
              <div>
                Rebooking nudges
                <small>"Time for your next cut?" a few weeks after each visit.</small>
              </div>
            </div>
            <p class="note">
              Every business gets a different set. <b>An auto shop</b> might get "your car is ready"
              texts and estimate requests instead.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 CUSTOM -->
    <section id="custom" class="custom">
      <div class="wrap">
        <div class="band">
          <div class="band-copy">
            <div class="label">02 · Built around you</div>
            <h2>Tell us what you need. <span class="grad">We build the workflow.</span></h2>
            <p class="sub">
              You tell us what slows you down or what you wish you could see at a glance. Our
