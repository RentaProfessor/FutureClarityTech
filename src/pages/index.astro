<script is:inline src="/fc-config.js"></script>
<script is:inline src="/fc-store.js"></script>

<script>
  // ---- in-page navigation -------------------------------------------------
  const header = document.querySelector('header')!;
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function goTo(id: string) {
    let y = 0;
    if (id !== '#top') {
      const sec = document.querySelector(id);
      if (!sec) return false;
      // Boxed sections line up by the box, not the title inside it.
      const mark = sec.querySelector('.band, .label, h2') || sec;
      y = mark.getBoundingClientRect().top + window.pageYOffset - header.getBoundingClientRect().height - 16;
    }
    window.scrollTo({ top: Math.max(0, y), behavior: reduce ? 'auto' : 'smooth' });
    if (id === '#contact') {
      setTimeout(
        () =>
          ['f-name', 'cf-name']
            .map((id) => document.getElementById(id))
            .find((el) => el && el.offsetParent)
            ?.focus({ preventScroll: true }),
        reduce ? 0 : 650
      );
    }
    return true;
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href^="#"]');
    if (!a || a.classList.contains('skip')) return;
    const id = a.getAttribute('href');
    if (!id || id.length < 2) return;
    if (goTo(id)) e.preventDefault();
  });

  // Highlight the section you are in.
  const links = Array.from(document.querySelectorAll('header nav a'));
  const secs = links.map((a) => document.querySelector(a.getAttribute('href') || ''));

  function mark() {
    const line = header.getBoundingClientRect().height + 40;
    let cur = -1;
    secs.forEach((s, i) => {
      if (s && s.getBoundingClientRect().top <= line) cur = i;
    });
    links.forEach((a, i) => {
      const on = i === cur;
      a.classList.toggle('on', on);
      if (on && window.innerWidth <= 900) {
        const n = a.parentNode as HTMLElement;
        const el = a as HTMLElement;
        const l = el.offsetLeft - 16;
        const outOfView =
          el.offsetLeft < n.scrollLeft || el.offsetLeft + el.offsetWidth > n.scrollLeft + n.clientWidth;
        if (Math.abs(n.scrollLeft - l) > 4 && outOfView) n.scrollTo({ left: l, behavior: 'auto' });
      }
    });
  }

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        mark();
      });
    },
    { passive: true }
  );
  mark();

  // ---- copy buttons -------------------------------------------------------
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => {
    b.addEventListener('click', () => {
      const t = b.getAttribute('data-copy') || '';
      const done = () => {
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = 'Copy'), 1800);
      };
      try {
        navigator.clipboard.writeText(t).then(done, () => (b.textContent = 'Select it above'));
      } catch {
        b.textContent = 'Select it above';
      }
    });
  });

  // ---- header call to action ---------------------------------------------
  // On a phone the header holds the page's actions: Call to begin with, and a
  // Free audit button once neither form is on screen. (Not a bar along the
  // bottom: iOS Safari's floating toolbar sits on top of one.)
  if ('IntersectionObserver' in window) {
    const onScreen = new Map<Element, boolean>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => onScreen.set(e.target, e.isIntersecting));
      header.classList.toggle('cta-on', ![...onScreen.values()].some(Boolean));
    });
    document.querySelectorAll('form[data-lead]').forEach((f) => io.observe(f));
  }

  // ---- where the visitor came from -----------------------------------------
  // Ad links carry utm_* tags or a click id (gclid and friends); other sites
  // show up as the referrer. Saved for 30 days so a visitor who clicks an ad,
  // leaves and comes back still counts for that ad, and sent with the request
  // as scope.src so the dashboard can say which ad brought each lead.
  const SRC_KEY = 'fc-src';
  const SRC_DAYS = 30;
  const TAGS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'msclkid'];

  function readSource(): Record<string, string> | null {
    const q = new URLSearchParams(window.location.search);
    const now: Record<string, string> = {};
    TAGS.forEach((k) => {
      const v = q.get(k);
      if (v) now[k] = v.slice(0, 200);
    });
    try {
      const r = new URL(document.referrer);
      if (r.host && r.host !== window.location.host) now.ref = r.host.slice(0, 100);
    } catch {}

    let saved: Record<string, string> | null = null;
    try { saved = JSON.parse(localStorage.getItem(SRC_KEY) || 'null'); } catch {}
    if (saved && Date.now() - Date.parse(saved.at || '') > SRC_DAYS * 864e5) saved = null;

    // A new ad click replaces the old one; a plain referrer only fills a gap.
    const isAd = TAGS.some((k) => now[k]);
    if (isAd || (!saved && now.ref)) {
      saved = { ...now, at: new Date().toISOString() };
      try { localStorage.setItem(SRC_KEY, JSON.stringify(saved)); } catch {}
    }
    return saved;
  }
  const source = readSource();

  // ---- lead forms ---------------------------------------------------------
  // Wider screens: #lead is step 1 of booking. Nothing is sent from it: the
  // details are handed to /plan.html, which sends the whole request to Supabase
  // on its Send button.
  // Phones: the form[data-lead] forms send the request straight to Supabase
  // (public/fc-store.js) in one submit, then thank the visitor in place.

  const form = document.getElementById('lead') as HTMLFormElement | null;

  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form[data-lead]'));
  const BOOKED_KEY = 'fc-booked';

  // Team shortcut: typing the dashboard code as the whole message opens
  // /dashboard/ instead of booking. The code is checked by the database
  // (supabase/dashboard_code.sql); neither the code nor a hash of it is in
  // this page. Only a short single-word message is checked, so real
  // enquiries never reach the database from here.
  const CODE_KEY = 'fc-dashboard-code';

  async function tryDashboardCode(text: string) {
    const t = text.trim();
    if (t.length < 6 || t.length > 64 || /\s/.test(t)) return false;
    const cfg = (window as any).FC_CONFIG;
    if (!cfg?.supabaseUrl || !cfg?.supabaseKey) return false;
    try {
      const res = await fetch(cfg.supabaseUrl.replace(/\/$/, '') + '/rest/v1/rpc/dashboard_check', {
        method: 'POST',
        headers: { apikey: cfg.supabaseKey, Authorization: `Bearer ${cfg.supabaseKey}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: t }),
      });
      if (!res.ok || (await res.json()) !== true) return false;
      try { localStorage.setItem(CODE_KEY, t); } catch {}
      return true;
    } catch {
      return false;
    }
  }

  if (form) {
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (await tryDashboardCode(val('f-msg'))) {
        window.location.href = '/dashboard/';
        return;
      }

      const required = ['f-name', 'f-business', 'f-contact'];
      const missing = required.filter((id) => {
        const el = document.getElementById(id) as HTMLInputElement;
        const empty = !el.value.trim();
        el.setAttribute('aria-invalid', empty ? 'true' : 'false');
        return empty;
      });

      const err = document.getElementById('formerr')!;
      const thanks = document.getElementById('thanks')!;

      if (missing.length) {
        err.style.display = 'block';
        thanks.style.display = 'none';
        document.getElementById(missing[0])?.focus();
        return;
      }
      err.style.display = 'none';

      const payload = {
        name: val('f-name'),
        business: val('f-business'),
        contact: val('f-contact'),
        website: val('f-site'),
        app: val('f-app'),
        msg: val('f-msg'),
      };

      // Hand the details to step 2, which greets them by name and pre-fills
      // the form. Both storages: sessionStorage can be unavailable in some
      // private-browsing modes.
      const handoff = JSON.stringify(payload);
      try { sessionStorage.setItem('fc-audit-request', handoff); } catch {}
      try { localStorage.setItem('fc-audit-request', handoff); } catch {}
      thanks.style.display = 'block';
      window.location.href = '/plan.html';
    });
  }
  // A phone number (7+ digits) or something shaped like an email address.
  const reachable = (s: string) => s.replace(/\D/g, '').length >= 7 || /^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i.test(s);

  // Both forms switch to the thank-you, so nobody sends the same request twice.
  function showDone(name: string, focus?: HTMLFormElement) {
    forms.forEach((f) => {
      f.querySelector<HTMLElement>('.lead-fields')!.hidden = true;
      const done = f.querySelector<HTMLElement>('.lead-done')!;
      done.hidden = false;
      const first = name.split(' ')[0];
      if (first) done.querySelector('[data-done-title]')!.textContent = `Thanks, ${first}. We've got it.`;
    });
    focus?.querySelector<HTMLElement>('.lead-done')?.focus();
  }

  try {
    const booked = sessionStorage.getItem(BOOKED_KEY);
    if (booked !== null) showDone(booked);
  } catch {}

  forms.forEach((form) => {
    const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const val = (name: string) => el(name).value.trim();
    const err = form.querySelector<HTMLElement>('.formerr')!;
    const fail = form.querySelector<HTMLElement>('.sendfail')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    let sending = false;

    // A field stops looking wrong as soon as it's being fixed.
    form.addEventListener('input', (e) => (e.target as HTMLElement).removeAttribute('aria-invalid'));

    form.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
      b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true')));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;

      if (await tryDashboardCode(val('msg'))) {
        window.location.href = '/dashboard/';
        return;
      }

      const bad = ['name', 'business', 'contact'].filter((n) => {
        const v = val(n);
        const wrong = !v || (n === 'contact' && !reachable(v));
        el(n).setAttribute('aria-invalid', wrong ? 'true' : 'false');
        return wrong;
      });
      if (bad.length) {
        err.hidden = false;
        el(bad[0]).focus();
        return;
      }
      err.hidden = true;

      const name = val('name');
      // A filled honeypot is a bot: look sent, send nothing.
      if (val('company_site')) {
        showDone(name, form);
        return;
      }

      const picked = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-pick][aria-pressed="true"]'));
      const keys = picked.map((b) => b.dataset.pick || '');
      const labels = picked.map((b) => b.textContent || '');
      const needs = [labels.length ? 'Interested in: ' + labels.join(', ') : '', val('msg')].filter(Boolean).join('\n');
      const payload = {
        name,
        business: val('business'),
        contact: val('contact'),
        needs,
        scope: {
          wf: keys.filter((k) => k !== 'website' && k !== 'app'),
          site: '',
          app: keys.includes('app'),
          care: false,
          ...(source ? { src: source } : {}),
        },
      };

      // If saving fails, the email and text buttons carry the request instead.
      const body = `Name: ${payload.name}\nBusiness: ${payload.business}\nPhone or email: ${payload.contact}${needs ? '\n' + needs : ''}`;
      const subject = 'Free audit request: ' + payload.business;
      form.querySelector<HTMLAnchorElement>('[data-mail]')!.href =
        'mailto:beng@futureclaritytechnologies.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      form.querySelector<HTMLAnchorElement>('[data-sms]')!.href = 'sms:+18189397964?&body=' + encodeURIComponent(subject + '\n' + body);

      sending = true;
      btn.disabled = true;
      btn.textContent = 'Sending…';
      try {
        await (window as any).FCStore.submit(payload);
        try { sessionStorage.setItem(BOOKED_KEY, name); } catch {}
        fail.hidden = true;
        showDone(name, form);
      } catch {
        btn.textContent = 'Try again';
        fail.hidden = false;
      }
      sending = false;
      btn.disabled = false;
    });
  });
</script>
