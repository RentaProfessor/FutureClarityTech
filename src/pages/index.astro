            <label class="fld"
              ><span>Business name</span><input id="f-business" name="business" autocomplete="organization" required /></label
            >
          </div>
          <label class="fld"
            ><span>Email or phone</span><input id="f-contact" name="contact" autocomplete="email" required /></label
          >
          <div class="two">
            <label class="fld"
              ><span>Website <i>optional</i></span><input id="f-site" name="website" autocomplete="url" inputmode="url" /></label
            >
            <label class="fld"><span>App name <i>optional</i></span><input id="f-app" name="app" /></label>
