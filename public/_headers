/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://bzudkcybqhmqrybskwfn.supabase.co; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# connect-src: the homepage (dashboard-code check), /plan.html and /dashboard/
# talk to the Supabase project only, over https. The Lead Finder's business list
# is served from this site (/data/places/), so it needs nothing else. No form
# posts anywhere off-site, so form-action is 'self'.
#
# frame-src is 'none' since the portfolio page and its demo iframes were
# retired. Restore an explicit allowlist if embeds come back — never '*'.

# Content-hashed build assets never change at a given URL — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons: cache for a day but always allow updates. (Previously this was a
# full year with no revalidation, which is why an old favicon could stick.)
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
/favicon-96.png
  Cache-Control: public, max-age=86400, must-revalidate
/favicon-192.png
  Cache-Control: public, max-age=86400, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# HTML pages must always revalidate so a new deploy shows immediately and the
# browser never serves a stale page. Extensionless clean URLs do not match
# /*.html, so any new route needs its own rule here.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Step 2 of the audit booking and the team dashboard are app pages, not
# content: keep them out of search results. noindex (not a robots.txt
# Disallow) so crawlers can still fetch them and see the instruction.
# Cloudflare Pages serves /plan.html at /plan, so both paths are listed.
/plan
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate
/plan.html
  X-Robots-Tag: noindex, nofollow
/dashboard
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

# The Lead Finder's business list (scripts/build-places.py). Revalidate so a
# refreshed list shows up right away; it's data, not content, so keep it out of
# search results.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Site settings and the data layer must never be served stale after an edit.
/fc-config.js
  Cache-Control: public, max-age=0, must-revalidate
/fc-store.js
  Cache-Control: public, max-age=0, must-revalidate
