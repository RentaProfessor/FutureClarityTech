/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://googleads.g.doubleclick.net https://www.google.com https://www.googleadservices.com; connect-src 'self' https://bzudkcybqhmqrybskwfn.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://cloudflareinsights.com; form-action 'self'; frame-src https://td.doubleclick.net https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# connect-src: the homepage (the free-quote form and the dashboard-code check)
# and /dashboard/ talk to the Supabase project only, over https. The Lead Finder's business list
# is served from this site (/data/places/), so it needs nothing else. No form
# posts anywhere off-site, so form-action is 'self'.
#
# Google Analytics / Google Ads (script, img, connect and the two frame-src
# hosts) are allowed here, but the pages only load them after a visitor says
# yes in the cookie banner (src/components/Consent.astro). Cloudflare Web
# Analytics (static.cloudflareinsights.com, cloudflareinsights.com) is
# cookie-free. Any other embed stays blocked — never '*'.

# Content-hashed build assets never change at a given URL — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons: cache for a day but always allow updates. (Previously this was a
# full year with no revalidation, which is why an old favicon could stick.)
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
/favicon-96.png
  Cache-Control: public, max-age=86400, must-revalidate
/favicon-192.png
  Cache-Control: public, max-age=86400, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# HTML pages must always revalidate so a new deploy shows immediately and the
# browser never serves a stale page. Extensionless clean URLs do not match
# /*.html, so any new route needs its own rule here.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Privacy, terms and accessibility. Astro writes these as folders, so they're
# served at /privacy/ and so on: revalidate like every other page.
/privacy/
  Cache-Control: public, max-age=0, must-revalidate
/terms/
  Cache-Control: public, max-age=0, must-revalidate
/accessibility/
  Cache-Control: public, max-age=0, must-revalidate

# The team dashboard is an app page, not content: keep it out of search
# results. noindex (not a robots.txt Disallow) so crawlers can still fetch it
# and see the instruction.
/dashboard
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

# The Lead Finder's business list (scripts/build-places.py). Revalidate so a
# refreshed list shows up right away; it's data, not content, so keep it out of
# search results.
/data/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Site settings and the data layer must never be served stale after an edit.
/fc-config.js
  Cache-Control: public, max-age=0, must-revalidate
/fc-store.js
  Cache-Control: public, max-age=0, must-revalidate
