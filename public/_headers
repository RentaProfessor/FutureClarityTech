/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action https://formspree.io; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# connect-src note: the lead form submits with fetch(), which is governed by
# connect-src — not form-action. When the form moves to Supabase, add that
# project's host here or the browser will block the request with no visible
# error:
#   connect-src 'self' https://formspree.io https://<project-ref>.supabase.co
#
# frame-src is 'none' since the portfolio page and its demo iframes were
# retired. Restore an explicit allowlist if embeds come back — never '*'.

# Content-hashed build assets never change at a given URL — cache hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons: cache for a day but always allow updates. (Previously this was a
# full year with no revalidation, which is why an old favicon could stick.)
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
/favicon-96.png
  Cache-Control: public, max-age=86400, must-revalidate
/favicon-192.png
  Cache-Control: public, max-age=86400, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate

# HTML pages must always revalidate so a new deploy shows immediately and the
# browser never serves a stale page. Extensionless clean URLs do not match
# /*.html, so any new route needs its own rule here.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
